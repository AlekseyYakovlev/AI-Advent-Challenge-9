# Режим: local | docker | prod
APP_ENV=local

# UI
CHAINLIT_HOST=0.0.0.0
CHAINLIT_PORT=8000

# Провайдер по умолчанию: lmstudio | ollama | deepseek
DEFAULT_PROVIDER=lmstudio
DEFAULT_MODEL=Bionic

# LM Studio (Windows host). /v1 опционален — для control API отрезается.
LMSTUDIO_BASE_URL=http://localhost:1234
LMSTUDIO_API_KEY=lm-studio
LMSTUDIO_LOAD_TIMEOUT=120
LMSTUDIO_EMERGENCY_UNLOAD_TIMEOUT=5
# Выгружать модель при остановке FastAPI (по умолчанию false — модель остаётся в VRAM)
LMSTUDIO_UNLOAD_ON_SHUTDOWN=false
LMSTUDIO_CIRCUIT_BREAKER_THRESHOLD=3
LMSTUDIO_CIRCUIT_BREAKER_COOLDOWN_SECONDS=120
LMSTUDIO_MODELS_CACHE_TTL_SECONDS=300
LMSTUDIO_REFRESH_MIN_INTERVAL_SECONDS=5

# Ollama (опционально)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama

# DeepSeek (шаг 2)
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=

# Параметры модели по умолчанию
DEFAULT_TEMPERATURE=0.7
DEFAULT_TOP_P=0.9
DEFAULT_MAX_TOKENS=2048
DEFAULT_SEED=42
REQUEST_TIMEOUT_SEC=120
HEALTH_TIMEOUT_SEC=5

# Защита от token bomb / переполнения контекста
MAX_ALLOWED_TOKENS=4096
MAX_HISTORY_MESSAGES=40
# Грубая эвристика: ~4 символа ≈ 1 токен (достаточно для MVP)
MAX_CONTEXT_CHARS=24000
DEFAULT_SYSTEM_PROMPT=

# Observability / health
HEALTH_VERBOSE=true
LOG_JSON=true

# M3: не слать top_k в OpenAI-compatible payload, пока не проверен бэкенд
ALLOW_TOP_K=false
